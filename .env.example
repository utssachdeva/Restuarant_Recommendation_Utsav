# Groq LLM provider
# Get a key at https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b
# Set true to skip live API calls (offline / UI development)
LLM_DRY_RUN=false

# Dataset
DATASET_ID=ManikaSaini/zomato-restaurant-recommendation

# Recommendation limits
TOP_N_CANDIDATES=20
TOP_K_RESULTS=5

# Budget bands (approx cost for two people)
BUDGET_LOW_MAX=500
BUDGET_MED_MAX=1000

# LLM request timeout in seconds
REQUEST_TIMEOUT=30

# Comma-separated browser origins allowed by the FastAPI CORS middleware.
# After Vercel deploy, append https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
